<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>jack4432｜iOS 簽名軟體安裝</title>

  <style>
    :root {
      --bg: #070b16;
      --card: rgba(255, 255, 255, 0.08);
      --card-border: rgba(255, 255, 255, 0.14);
      --text: #f8fafc;
      --muted: #a8b3c7;
      --primary: #6d5dfc;
      --primary-2: #00d4ff;
      --success: #22c55e;
      --shadow: 0 24px 80px rgba(0, 0, 0, 0.35);
      --radius: 24px;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      min-height: 100vh;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans TC",
        "Microsoft JhengHei", Arial, sans-serif;
      color: var(--text);
      background:
        radial-gradient(circle at top left, rgba(109, 93, 252, 0.32), transparent 34%),
        radial-gradient(circle at top right, rgba(0, 212, 255, 0.22), transparent 32%),
        var(--bg);
      overflow-x: hidden;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    img {
      max-width: 100%;
      display: block;
    }

    .container {
      width: min(1160px, calc(100% - 36px));
      margin: 0 auto;
    }

    .glass {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid var(--card-border);
      box-shadow: var(--shadow);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
    }

    .navbar {
      position: sticky;
      top: 0;
      z-index: 100;
      padding: 14px 0;
      background: rgba(7, 11, 22, 0.72);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }

    .nav-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .logo {
      font-weight: 900;
      font-size: 1.2rem;
      letter-spacing: 0.4px;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 22px;
      color: var(--muted);
      font-size: 0.95rem;
    }

    .nav-links a:hover {
      color: var(--text);
    }

    .nav-install {
      padding: 10px 16px;
      border-radius: 999px;
      color: #fff;
      background: linear-gradient(135deg, var(--primary), var(--primary-2));
      font-weight: 700;
    }

    .menu-btn {
      display: none;
      width: 44px;
      height: 44px;
      border: 1px solid var(--card-border);
      background: rgba(255, 255, 255, 0.08);
      color: var(--text);
      border-radius: 14px;
      cursor: pointer;
      font-size: 1.3rem;
    }

    .hero {
      padding: 92px 0 56px;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 36px;
      align-items: center;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 14px;
      border-radius: 999px;
      background: rgba(34, 197, 94, 0.13);
      border: 1px solid rgba(34, 197, 94, 0.28);
      color: #bbf7d0;
      font-size: 0.92rem;
      margin-bottom: 18px;
    }

    .pulse {
      width: 9px;
      height: 9px;
      border-radius: 999px;
      background: var(--success);
      animation: pulse 1.6s infinite;
    }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.55); }
      70% { box-shadow: 0 0 0 10px rgba(34, 197, 94, 0); }
      100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
    }

    h1 {
      font-size: clamp(2.55rem, 7vw, 5.4rem);
      line-height: 0.98;
      letter-spacing: -3px;
      margin-bottom: 22px;
    }

    .gradient-text {
      background: linear-gradient(135deg, #fff, #a5b4fc 45%, #67e8f9);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hero p {
      color: var(--muted);
      font-size: 1.12rem;
      line-height: 1.85;
      max-width: 650px;
      margin-bottom: 28px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      align-items: center;
      margin-bottom: 26px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      padding: 0 22px;
      border-radius: 16px;
      border: 0;
      cursor: pointer;
      font-weight: 800;
      font-size: 0.98rem;
      transition: 0.28s ease;
    }

    .btn-primary {
      color: #fff;
      background: linear-gradient(135deg, var(--primary), var(--primary-2));
      box-shadow: 0 18px 36px rgba(109, 93, 252, 0.28);
    }

    .btn-primary:hover,
    .btn-secondary:hover {
      transform: translateY(-3px);
    }

    .btn-secondary {
      color: var(--text);
      background: rgba(255, 255, 255, 0.09);
      border: 1px solid var(--card-border);
    }

    .mini-stats {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      color: var(--muted);
      font-size: 0.94rem;
    }

    .hero-card {
      border-radius: 32px;
      padding: 26px;
      overflow: hidden;
    }

    .phone {
      margin: 0 auto;
      max-width: 360px;
      min-height: 520px;
      border-radius: 48px;
      padding: 18px;
      background: linear-gradient(160deg, rgba(255,255,255,0.25), rgba(255,255,255,0.05));
      border: 1px solid rgba(255, 255, 255, 0.16);
      box-shadow: 0 32px 80px rgba(0, 0, 0, 0.46);
    }

    .phone-screen {
      min-height: 484px;
      border-radius: 36px;
      padding: 22px;
      background: linear-gradient(180deg, rgba(13,20,38,0.96), rgba(7,11,22,0.96));
    }

    .phone-notch {
      width: 120px;
      height: 28px;
      background: #050816;
      border-radius: 0 0 18px 18px;
      margin: -22px auto 18px;
    }

    .screen-title {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 22px;
    }

    .status-dot {
      width: 12px;
      height: 12px;
      background: var(--success);
      border-radius: 999px;
      box-shadow: 0 0 24px rgba(34, 197, 94, 0.8);
    }

    .app-preview-list {
      display: grid;
      gap: 14px;
    }

    .app-preview {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 14px;
      border-radius: 20px;
      background: rgba(255, 255, 255, 0.07);
      border: 1px solid rgba(255, 255, 255, 0.08);
    }

    .app-preview img {
      width: 48px;
      height: 48px;
      border-radius: 14px;
      object-fit: cover;
    }

    .app-preview h4 {
      font-size: 0.98rem;
      margin-bottom: 4px;
    }

    .app-preview p {
      font-size: 0.78rem;
      margin: 0;
      color: var(--muted);
      line-height: 1.4;
    }

    section {
      padding: 74px 0;
    }

    .section-head {
      text-align: center;
      margin-bottom: 36px;
    }

    .section-head .eyebrow {
      color: #93c5fd;
      font-weight: 800;
      margin-bottom: 10px;
      letter-spacing: 1.4px;
      text-transform: uppercase;
      font-size: 0.82rem;
    }

    .section-head h2 {
      font-size: clamp(2rem, 5vw, 3.2rem);
      letter-spacing: -1.5px;
      margin-bottom: 14px;
    }

    .section-head p {
      color: var(--muted);
      line-height: 1.8;
      max-width: 760px;
      margin: 0 auto;
    }

    .features {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .feature-card,
    .step-card,
    .app-card,
    .certificate-card {
      border-radius: var(--radius);
      padding: 24px;
      background: var(--card);
      border: 1px solid var(--card-border);
      transition: 0.28s ease;
    }

    .feature-card:hover,
    .step-card:hover,
    .app-card:hover {
      transform: translateY(-6px);
      background: rgba(255, 255, 255, 0.11);
    }

    .icon {
      width: 54px;
      height: 54px;
      display: grid;
      place-items: center;
      border-radius: 18px;
      margin-bottom: 18px;
      background: linear-gradient(135deg, var(--primary), var(--primary-2));
      font-size: 1.4rem;
    }

    .feature-card h3,
    .step-card h3,
    .app-card h3 {
      margin-bottom: 12px;
      font-size: 1.15rem;
    }

    .feature-card p,
    .step-card p,
    .app-card p,
    .certificate-card p {
      color: var(--muted);
      line-height: 1.78;
      font-size: 0.95rem;
    }

    .certificate-wrap {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
    }

    .certificate-card {
      padding: 30px;
    }

    .certificate-name {
      display: inline-flex;
      padding: 13px 16px;
      margin: 16px 0 18px;
      border-radius: 16px;
      background: rgba(34, 197, 94, 0.12);
      border: 1px solid rgba(34, 197, 94, 0.25);
      color: #bbf7d0;
      font-weight: 900;
    }

    .certificate-meta {
      display: grid;
      gap: 12px;
      margin-top: 16px;
    }

    .meta-row {
      display: flex;
      justify-content: space-between;
      gap: 18px;
      padding: 14px;
      border-radius: 16px;
      background: rgba(255, 255, 255, 0.06);
      color: var(--muted);
    }

    .meta-row strong {
      color: var(--text);
    }

    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .step-number {
      width: 46px;
      height: 46px;
      display: grid;
      place-items: center;
      border-radius: 16px;
      margin-bottom: 18px;
      background: rgba(250, 204, 21, 0.13);
      color: #fde68a;
      font-weight: 900;
      font-size: 1.15rem;
    }

    .apps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .app-card {
      display: flex;
      flex-direction: column;
    }

    .app-logo {
      width: 82px;
      height: 82px;
      object-fit: cover;
      border-radius: 24px;
      margin-bottom: 18px;
      background: rgba(255, 255, 255, 0.12);
    }

    .cert {
      margin: 10px 0 18px;
      display: inline-flex;
      width: fit-content;
      padding: 8px 11px;
      border-radius: 999px;
      font-size: 0.8rem;
      color: #bfdbfe;
      background: rgba(59, 130, 246, 0.13);
      border: 1px solid rgba(59, 130, 246, 0.22);
    }

    .cta {
      padding-bottom: 90px;
    }

    .cta-box {
      border-radius: 34px;
      padding: 46px;
      text-align: center;
      background:
        linear-gradient(135deg, rgba(109, 93, 252, 0.32), rgba(0, 212, 255, 0.18)),
        rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.16);
      box-shadow: var(--shadow);
    }

    .cta h2 {
      font-size: clamp(2rem, 5vw, 3.5rem);
      letter-spacing: -1.5px;
      margin-bottom: 14px;
    }

    .cta p {
      max-width: 720px;
      margin: 0 auto 24px;
      color: var(--muted);
      line-height: 1.85;
    }

    .notice {
      margin-top: 18px;
      color: rgba(255, 255, 255, 0.72);
      font-size: 0.9rem;
      line-height: 1.6;
    }

    footer {
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      padding: 28px 0;
      color: var(--muted);
      font-size: 0.92rem;
    }

    .footer-inner {
      display: flex;
      justify-content: space-between;
      gap: 18px;
      flex-wrap: wrap;
      align-items: center;
    }

    .toast {
      position: fixed;
      left: 50%;
      bottom: 26px;
      transform: translateX(-50%) translateY(20px);
      opacity: 0;
      pointer-events: none;
      z-index: 999;
      min-width: 280px;
      max-width: calc(100% - 32px);
      padding: 14px 18px;
      border-radius: 16px;
      color: #fff;
      background: rgba(15, 23, 42, 0.92);
      border: 1px solid rgba(255, 255, 255, 0.16);
      text-align: center;
      transition: 0.28s ease;
    }

    .toast.show {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }

    .reveal {
      opacity: 0;
      transform: translateY(22px);
      transition: 0.7s ease;
    }

    .reveal.show {
      opacity: 1;
      transform: translateY(0);
    }

    @media (max-width: 980px) {
      .hero-grid,
      .certificate-wrap {
        grid-template-columns: 1fr;
      }

      .features {
        grid-template-columns: repeat(2, 1fr);
      }

      .steps,
      .apps {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 760px) {
      .nav-links {
        position: absolute;
        top: 73px;
        left: 18px;
        right: 18px;
        display: none;
        flex-direction: column;
        align-items: stretch;
        gap: 8px;
        padding: 14px;
        border-radius: 22px;
        background: rgba(7, 11, 22, 0.94);
        border: 1px solid rgba(255, 255, 255, 0.12);
      }

      .nav-links.active {
        display: flex;
      }

      .nav-links a {
        padding: 12px 14px;
      }

      .menu-btn {
        display: inline-grid;
        place-items: center;
      }

      .features {
        grid-template-columns: 1fr;
      }

      .cta-box {
        padding: 34px 22px;
      }

      .meta-row {
        flex-direction: column;
        gap: 6px;
      }
    }
  </style>
</head>

