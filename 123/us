<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Jack Featured Videos</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    min-height: 100vh;
    color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Arial, sans-serif;
    background:
        radial-gradient(circle at 15% 5%, rgba(255, 215, 0, 0.22), transparent 30%),
        radial-gradient(circle at 90% 60%, rgba(255, 145, 0, 0.16), transparent 34%),
        linear-gradient(180deg, #030303, #0b0b0d 55%, #050505);
    overflow-x: hidden;
}

body::before {
    content: "";
    position: fixed;
    inset: 0;
    background-image:
        linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
    background-size: 42px 42px;
    pointer-events: none;
    z-index: -1;
}

.marquee {
    overflow: hidden;
    background: rgba(0, 0, 0, 0.7);
    border-bottom: 1px solid rgba(255, 215, 0, 0.35);
    backdrop-filter: blur(14px);
}

.marquee-content {
    width: max-content;
    display: flex;
    animation: marquee 24s linear infinite;
}

.marquee-content span {
    padding: 12px 34px;
    white-space: nowrap;
    color: #ffe88a;
    font-size: 14px;
    font-weight: 900;
    letter-spacing: 1px;
}

@keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
}

.header {
    max-width: 1200px;
    margin: auto;
    padding: 24px 20px 0;
}

.nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
}

.logo {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 18px;
    font-weight: 950;
}

.logo-icon {
    width: 42px;
    height: 42px;
    border-radius: 14px;
    display: grid;
    place-items: center;
    color: #111;
    background: linear-gradient(135deg, #fff6b8, #ffd700, #c98b00);
    box-shadow: 0 0 28px rgba(255, 215, 0, 0.4);
}

.nav-badge {
    padding: 10px 16px;
    border: 1px solid rgba(255, 215, 0, 0.32);
    border-radius: 999px;
    color: #ffe88a;
    font-size: 13px;
    font-weight: 900;
    background: rgba(255,255,255,0.06);
}

.hero {
    max-width: 1200px;
    margin: auto;
    padding: 72px 20px 42px;
    text-align: center;
}

.hero-label {
    display: inline-block;
    margin-bottom: 18px;
    padding: 9px 15px;
    border: 1px solid rgba(255, 215, 0, 0.35);
    border-radius: 999px;
    color: #ffe88a;
    background: rgba(255, 215, 0, 0.09);
    font-size: 13px;
    font-weight: 950;
    letter-spacing: 1px;
}

.hero h1 {
    font-size: clamp(42px, 8vw, 78px);
    line-height: 1.08;
    margin-bottom: 18px;
    background: linear-gradient(100deg, #fff, #fff0a5, #ffd700, #ffad22);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.hero p {
    max-width: 720px;
    margin: auto;
    color: #bdbdca;
    font-size: 16px;
    line-height: 1.8;
}

.hero-btns {
    margin-top: 28px;
    display: flex;
    justify-content: center;
    gap: 12px;
    flex-wrap: wrap;
}

.hero-btn {
    min-height: 46px;
    padding: 0 20px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    font-weight: 950;
    transition: 0.25s;
}

.hero-btn.primary {
    color: #111;
    background: linear-gradient(135deg, #fff3a6, #ffd700, #c98b00);
    box-shadow: 0 14px 30px rgba(255, 215, 0, 0.24);
}

.hero-btn.secondary {
    color: #ffe88a;
    border: 1px solid rgba(255, 215, 0, 0.35);
    background: rgba(255,255,255,0.06);
}

.hero-btn:hover {
    transform: translateY(-3px);
}

.section {
    max-width: 1200px;
    margin: auto;
    padding: 34px 20px 64px;
}

.section-head {
    margin-bottom: 24px;
    text-align: center;
}

.section-head span {
    display: block;
    margin-bottom: 8px;
    color: #ffd700;
    font-size: 13px;
    font-weight: 950;
    letter-spacing: 1.5px;
}

.section-head h2 {
    font-size: clamp(30px, 4vw, 42px);
}

.grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
    align-items: start;
}

.card {
    position: relative;
    height: auto;
    padding: 24px;
    border-radius: 28px;
    overflow: hidden;
    border: 1px solid rgba(255, 215, 0, 0.24);
    background:
        radial-gradient(circle at top right, rgba(255, 215, 0, 0.18), transparent 36%),
        linear-gradient(145deg, rgba(255,255,255,0.13), rgba(255,255,255,0.04));
    backdrop-filter: blur(18px);
    box-shadow: 0 24px 60px rgba(0,0,0,0.28);
    transition: 0.32s ease;
}

.card:hover {
    transform: translateY(-8px);
    border-color: rgba(255, 215, 0, 0.55);
    box-shadow: 0 28px 70px rgba(255,215,0,0.14);
}

.card::after {
    content: "";
    position: absolute;
    top: -70%;
    left: -90%;
    width: 70%;
    height: 240%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.16), transparent);
    transform: rotate(25deg);
    transition: 0.7s;
}

.card:hover::after {
    left: 130%;
}

.card-content {
    position: relative;
    z-index: 2;
}

.card-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 18px;
}

.icon {
    width: 62px;
    height: 62px;
    flex: 0 0 62px;
    border-radius: 22px;
    display: grid;
    place-items: center;
    color: #111;
    font-size: 27px;
    background: linear-gradient(135deg, #fff6b8, #ffd700, #c98b00);
    box-shadow: 0 12px 28px rgba(255, 215, 0, 0.3);
}

.tag {
    padding: 7px 11px;
    border-radius: 999px;
    color: #ffe88a;
    border: 1px solid rgba(255, 215, 0, 0.3);
    background: rgba(0,0,0,0.25);
    font-size: 12px;
    font-weight: 950;
    white-space: nowrap;
}

.card h3 {
    font-size: 24px;
    line-height: 1.28;
    margin-bottom: 10px;
}

.card p {
    color: #bdbdca;
    font-size: 15px;
    line-height: 1.65;
    margin-bottom: 16px;
}

.meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
}

.meta span {
    padding: 7px 10px;
    border-radius: 999px;
    color: rgba(255,255,255,0.88);
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.08);
    font-size: 12px;
    font-weight: 700;
}

.actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

.btn {
    min-height: 43px;
    padding: 0 16px;
    border-radius: 13px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #111;
    text-decoration: none;
    font-size: 13px;
    font-weight: 950;
    background: linear-gradient(135deg, #fff3a6, #ffd700, #c98b00);
    box-shadow: 0 12px 26px rgba(255, 215, 0, 0.22);
    transition: 0.25s;
}

.btn.outline {
    color: #ffe88a;
    border: 1px solid rgba(255, 215, 0, 0.38);
    background: rgba(255,255,255,0.045);
    box-shadow: none;
}

.btn.instagram {
    color: #fff;
    background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
    box-shadow: 0 12px 26px rgba(253, 29, 29, 0.22);
}

.btn:hover {
    transform: translateY(-2px) scale(1.03);
}

.ribbon {
    position: absolute;
    top: 22px;
    right: -42px;
    width: 150px;
    padding: 7px 0;
    text-align: center;
    transform: rotate(42deg);
    color: white;
    background: linear-gradient(135deg, #ff3d68, #c9003d);
    font-size: 12px;
    font-weight: 950;
    letter-spacing: 1px;
    z-index: 4;
}

.ribbon.top {
    color: #111;
    background: linear-gradient(135deg, #fff2a3, #ffd700, #b88400);
}

.ribbon.ig {
    background: linear-gradient(135deg, #833ab4, #fd1d1d, #fcb045);
}

.wide-card {
    grid-column: span 3;
}

.wide-layout {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 18px;
    align-items: center;
}

.footer {
    padding: 0 20px 36px;
    text-align: center;
    color: rgba(255,255,255,0.45);
    font-size: 13px;
}

/* Desktop / small laptop */
@media(max-width: 1100px) {
    .grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .wide-card {
        grid-column: span 2;
    }
}

/* Tablet */
@media(max-width: 820px) {
    .header {
        padding-top: 20px;
    }

    .hero {
        padding: 58px 20px 34px;
    }

    .section {
        padding-top: 28px;
        padding-bottom: 52px;
    }

    .grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 18px;
    }

    .card {
        padding: 22px;
        border-radius: 26px;
    }

    .card h3 {
        font-size: 22px;
    }

    .wide-card {
        grid-column: span 2;
    }

    .wide-layout {
        grid-template-columns: 1fr;
    }
}

/* Mobile */
@media(max-width: 600px) {
    .marquee-content span {
        padding: 11px 24px;
        font-size: 13px;
    }

    .nav {
        align-items: flex-start;
        flex-direction: column;
    }

    .nav-badge {
        font-size: 12px;
    }

    .hero {
        padding: 48px 18px 28px;
    }

    .hero p {
        font-size: 15px;
    }

    .hero-btns {
        flex-direction: column;
    }

    .hero-btn {
        width: 100%;
    }

    .section {
        padding: 26px 16px 46px;
    }

    .grid {
        grid-template-columns: 1fr;
        gap: 18px;
    }

    .wide-card {
        grid-column: span 1;
    }

    .card {
        padding: 21px;
        border-radius: 25px;
    }

    .card-top {
        margin-bottom: 16px;
    }

    .icon {
        width: 58px;
        height: 58px;
        flex-basis: 58px;
        border-radius: 20px;
        font-size: 25px;
    }

    .card h3 {
        font-size: 21px;
    }

    .card p {
        font-size: 14px;
    }

    .actions {
        flex-direction: column;
    }

    .btn {
        width: 100%;
    }
}

/* Small mobile */
@media(max-width: 380px) {
    .card {
        padding: 18px;
    }

    .tag {
        font-size: 11px;
        padding: 6px 9px;
    }

    .hero h1 {
        font-size: 38px;
    }
}
</style>
</head>

